{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "isolatedModules": false,
    "lib": ["es2022", "dom", "dom.iterable"],
    "outDir": "./build",
    "rootDir": "..",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "*.ts"
  ],
  "ts-node": {
    "compilerOptions": {
      "outDir": null
    }
  }
}